<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="payload_box">
  <xacro:property name="payload_mass" value="3.0"/>
  <xacro:property name="payload_size_x" value="0.2"/>
  <xacro:property name="payload_size_y" value="0.2"/>
  <xacro:property name="payload_size_z" value="0.2"/>

  <xacro:macro name="box_inertia" params="mass size_x size_y size_z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (size_y**2 + size_z**2) / 12}"
        ixy="0"
        ixz="0"
        iyy="${mass * (size_x**2 + size_z**2) / 12}"
        iyz="0"
        izz="${mass * (size_x**2 + size_y**2) / 12}"/>
    </inertial>
  </xacro:macro>

  <link name="payload_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${payload_size_x} ${payload_size_y} ${payload_size_z}"/>
      </geometry>
      <material name="payload_color">
        <color rgba="0.9 0.6 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${payload_size_x} ${payload_size_y} ${payload_size_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${payload_mass}" size_x="${payload_size_x}" size_y="${payload_size_y}" size_z="${payload_size_z}"/>
  </link>

</robot>
