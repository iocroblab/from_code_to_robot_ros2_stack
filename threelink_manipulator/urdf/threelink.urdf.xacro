<?xml version="1.0"?>
<!--
  Simplified 3-DOF manipulator for teaching inertia calculation.
  - Compact model (no ground plane or end-effector link).
  - Base and moving links have inertial blocks for Gazebo.
  Box (length along X, width along Y, height along Z) inertia about its center:
    Ixx = (m/12) * (width^2 + height^2)
    Iyy = (m/12) * (length^2 + height^2)
    Izz = (m/12) * (length^2 + width^2)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="threelink_easy">
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Mass and geometry (kept from the original file) -->
  <xacro:property name="link_mass" value="3.0"/>
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="link1_length" value="0.3"/>
  <xacro:property name="link_length" value="0.5"/>
  <xacro:property name="link_width" value="0.1"/>
  <xacro:property name="link_height" value="0.1"/>

  <!-- DH parameters (all joints rotate about local Z) -->
  <xacro:property name="a1" value="${link1_length}"/>
  <xacro:property name="alpha1" value="${PI/2}"/>
  <xacro:property name="a2" value="${link_length}"/>
  <xacro:property name="alpha2" value="0.0"/>
  <xacro:property name="a3" value="${link_length}"/>
  <xacro:property name="alpha3" value="0.0"/>

  <!-- Shoulder pan joint housing -->
  <xacro:property name="joint_radius" value="0.15"/>
  <xacro:property name="joint_length" value="0.1"/>

  <!-- Standard box inertia aligned with X as the long axis -->
  <xacro:macro name="box_inertia_x" params="mass length width height com_x:=0 com_y:=0 com_z:=0">
    <inertial>
      <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (width**2 + height**2) / 12}"
        ixy="0"
        ixz="0"
        iyy="${mass * (length**2 + height**2) / 12}"
        iyz="0"
        izz="${mass * (length**2 + width**2) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- World link (root for Gazebo) -->
  <link name="world"/>

  <!-- Link 1: Shoulder pan link -->
  <link name="shoulder_pan_link">
    <visual>
      <origin xyz="${a1/2} 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="${a1} ${link_width} ${link_width}"/>
      </geometry>
      <material name="link1_color">
        <color rgba="0.2 0.1 0.8 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${joint_radius}" length="0.3"/>
      </geometry>
      <material name="joint_color">
        <color rgba="0.3 0.3 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${a1/2} 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="${a1} ${link_width} ${link_width}"/>
      </geometry>
    </collision>
    <xacro:box_inertia_x mass="${base_mass}" length="${a1}" width="${link_width}" height="${link_width}" com_x="${a1/2}" com_z="0.2"/>
  </link>

  <!-- Link 2: Shoulder lift link -->
  <link name="shoulder_lift_link">
    <visual>
      <origin xyz="${a2/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${a2} ${link_width} ${link_width}"/>
      </geometry>
      <material name="link2_color">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${a2/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${a2} ${link_width} ${link_width}"/>
      </geometry>
    </collision>
    <xacro:box_inertia_x mass="${link_mass}" length="${a2}" width="${link_width}" height="${link_width}" com_x="${a2/2}"/>
  </link>

  <!-- Link 3: Elbow link -->
  <link name="elbow_link">
    <visual>
      <origin xyz="${a3/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${a3} ${link_width} ${link_width}"/>
      </geometry>
      <material name="link3_color">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${a3/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${a3} ${link_width} ${link_width}"/>
      </geometry>
    </collision>
    <xacro:box_inertia_x mass="${link_mass}" length="${a3}" width="${link_width}" height="${link_width}" com_x="${a3/2}"/>
  </link>

  <!-- Tool frame at the end of the elbow link -->
  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.002"/>
      </geometry>
      <material name="tool0_color">
        <color rgba="0.1 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <!-- Joints (all revolute about Z) -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="world"/>
    <child link="shoulder_pan_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1000.0" upper="1000.0" effort="150.0" velocity="2.0"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_pan_link"/>
    <child link="shoulder_lift_link"/>
    <origin xyz="${a1} 0 0.2" rpy="${alpha1} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1000.0" upper="1000.0" effort="150.0" velocity="2.0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_lift_link"/>
    <child link="elbow_link"/>
    <origin xyz="${a2} 0 0" rpy="${alpha2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1000.0" upper="1000.0" effort="150.0" velocity="2.0"/>
  </joint>

  <joint name="tool0_joint" type="fixed">
    <parent link="elbow_link"/>
    <child link="tool0"/>
    <origin xyz="${a3} 0 0" rpy="0 0 0"/>
  </joint>
  <!-- Preserve the fixed joint so tool0 remains a distinct link in Gazebo Sim. -->
  <gazebo reference="tool0_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ros2_control block kept minimal for compatibility -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo + gz_ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find threelink_manipulator)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Detachable joint plugin to attach payloads at elbow_link -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>elbow_link</parent_link>
      <child_model>payload_box</child_model>
      <child_link>payload_link</child_link>
      <attach_topic>/payload/attach</attach_topic>
      <detach_topic>/payload/detach</detach_topic>
    </plugin>
  </gazebo>
</robot>
