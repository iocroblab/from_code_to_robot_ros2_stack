repositories:
  Universal_Robots_Client_Library:
    type: git
    url: https://github.com/UniversalRobots/Universal_Robots_Client_Library.git
    version: main

  Universal_Robots_ROS2_Description:
    type: git
    # For PRIVATE stack, keep gitioc URL. For PUBLIC mirror, swap this URL.
    url: https://gitioc.upc.edu/robots/universal_robots_ros2_description_tutorial.git
    version: jazzy

  Universal_Robots_ROS2_Driver:
    type: git
    url: https://gitioc.upc.edu/robots/universal_robots_ros2_driver_tutorial.git
    version: jazzy

  Universal_Robots_ROS2_GZ_Simulation:
    type: git
    url: https://gitioc.upc.edu/robots/universal_robots_ros2_gz_simulation_tutorial.git
    version: jazzy

  joint_state_publisher:
    type: git
    url: https://github.com/ros/joint_state_publisher.git
    version: main